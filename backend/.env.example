# Copy to .env for local testing only. On Cloud Run, set these as service env vars
# (GEMINI_SECRET_RESOURCE) plus attach a service account with Secret Manager access —
# never put the actual Gemini API key in an env var.

# Full resource name of the secret version, e.g.:
# projects/123456789/secrets/gemini-api-key/versions/latest
GEMINI_SECRET_RESOURCE=

# Comma-separated allowed origin for CORS, e.g. https://your-project.web.app
ALLOWED_ORIGIN=

PORT=8080
